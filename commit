#!/usr/bin/env dart
import 'dart:io';

String run(List<String> args, {bool fail = true}) {
  final r = Process.runSync('git', args);
  if (fail && r.exitCode != 0) {
    stderr.writeln(r.stderr);
    exit(r.exitCode);
  }
  return r.stdout.toString().trim();
}

bool isRepo() =>
    Process.runSync('git', ['rev-parse', '--is-inside-work-tree']).exitCode == 0;

void main(List<String> args) async {
  final push = args.contains('--push');

  if (!isRepo()) {
    print('Initializing repo...');
    run(['init']);
  }

  stdout.write('Commit message: ');
  final msg = stdin.readLineSync()?.trim();
  if (msg == null || msg.isEmpty) exit(1);

  run(['add', '.']);
  run(['commit', '-m', msg]);
  print('Committed.');

  if (!push) return;

  final branch = run(['rev-parse', '--abbrev-ref', 'HEAD']);
  final remotes = run(['remote'])
      .split(RegExp(r'\r?\n'))
      .where((e) => e.isNotEmpty)
      .toList();

  if (remotes.isEmpty) {
    stderr.writeln('No remote found.');
    exit(1);
  }

  final remote = remotes.length == 1
      ? remotes.first
      : () {
          for (var i = 0; i < remotes.length; i++) {
            print('[${i + 1}] ${remotes[i]}');
          }
          stdout.write('Choose remote: ');
          final i = int.tryParse(stdin.readLineSync() ?? '');
          if (i == null || i < 1 || i > remotes.length) exit(1);
          return remotes[i - 1];
        }();

  print('Pushing to $remote/$branch...\n');

  final p = await Process.start('git', ['push', remote, branch], runInShell: true);
  stdout.addStream(p.stdout);
  stderr.addStream(p.stderr);

  exit(await p.exitCode);
}